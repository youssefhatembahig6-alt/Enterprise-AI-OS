# Context filter for backend/Dockerfile.test (build context: repository root).
# Allowlist: only the four trees the tests read.
*
!backend
!scripts
!ml
!docs

# Then drop everything git ignores inside them, so no private or local artifact
# (secrets, credentials, raw benchmark output, virtualenvs) can enter the image.
**/.env
**/.env.*
**/*.pem
**/*.key
**/var
**/.venv
**/node_modules
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/dist
**/coverage
**/*.tsbuildinfo
ml/gpu-feasibility/**/*.zip
ml/gpu-feasibility/**/vllm-*.log
