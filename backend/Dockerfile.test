# syntax=docker/dockerfile:1
# Backend test image (`python3 scripts/dev.py test-backend`). Never used for the running
# stack. Build context: the repository root, filtered by Dockerfile.test.dockerignore,
# which admits only backend/, scripts/, ml/ and docs/ and drops everything git ignores
# (var/, .env, keys, virtualenvs, caches, raw GPU outputs). The tree is laid out as in a
# checkout (/repo/backend, /repo/scripts, ...) so tests that read the acceptance scripts,
# ML notebooks or committed evidence resolve them exactly as CI does.
#
# Git: the git binary is installed here; the repository metadata is NOT baked in. The
# compose service mounts the checkout's .git read-only at /repo/.git for tests that read
# history or HEAD (the M7 freeze checks).
FROM python:3.13.7-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/repo/backend \
    GIT_CONFIG_COUNT=1 \
    GIT_CONFIG_KEY_0=safe.directory \
    GIT_CONFIG_VALUE_0=/repo
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app
WORKDIR /repo/backend
COPY backend/requirements.lock backend/requirements-dev.lock ./
RUN pip install --require-hashes --no-deps -r requirements.lock \
    && pip install --require-hashes --no-deps -r requirements-dev.lock
COPY scripts /repo/scripts
COPY ml /repo/ml
COPY docs /repo/docs
COPY --chown=app:app backend /repo/backend
# WORKDIR created /repo/backend as root; the tests write caches and temp files there.
RUN chown app:app /repo/backend && mkdir -p /app/var && chown app:app /app/var
USER app
CMD ["pytest", "-q"]
