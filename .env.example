# Copy to .env with:  python scripts/dev.py init-env   (generates random secrets)
# Never commit .env. Every value below is a placeholder.
EAIOS_ENV=development

# PostgreSQL superuser: used only by the postgres container's first-run init
# script and by the optional test profile. The app never connects with it.
POSTGRES_SUPERUSER_PASSWORD=change-me
# Privileged migration/owner role (migrate and seed-dev only).
EAIOS_OWNER_DB_PASSWORD=change-me
# Restricted application role (api, worker, scheduler). Subject to RLS.
EAIOS_APP_DB_PASSWORD=change-me

REDIS_PASSWORD=change-me

# At least 32 random bytes. Signs short-lived access tokens; backend only.
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-bytes
JWT_ISSUER=eaios-api
JWT_AUDIENCE=eaios-web
ACCESS_TOKEN_TTL_SECONDS=900

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VITE_API_BASE_URL=http://localhost:8000

# External model gateway (Colab). Optional and unused in M0; when set, /ready
# reports model_inference=external_unchecked, never "available".
LLM_BASE_URL=
