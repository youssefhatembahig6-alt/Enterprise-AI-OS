# Copy to .env with:  python scripts/dev.py init-env   (generates random secrets)
# Never commit .env. Every value below is a placeholder.
EAIOS_ENV=development

# PostgreSQL superuser: used only by the postgres container's first-run init
# script and by the optional test profile. The app never connects with it.
POSTGRES_SUPERUSER_PASSWORD=change-me
# Privileged migration/owner role (migrate and seed-dev only).
EAIOS_OWNER_DB_PASSWORD=change-me
# Restricted application role (api, worker, scheduler). Subject to RLS.
EAIOS_APP_DB_PASSWORD=change-me
# Separate read-only report query role (M2): reporting views only, RLS-bound.
EAIOS_REPORT_DB_PASSWORD=change-me

REDIS_PASSWORD=change-me

# At least 32 random bytes. Signs short-lived access tokens; backend only.
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-bytes
JWT_ISSUER=eaios-api
JWT_AUDIENCE=eaios-web
ACCESS_TOKEN_TTL_SECONDS=900

# Argon2 verification is ~64 MiB each; 2 concurrent slots fit the 384 MiB API limit.
PASSWORD_VERIFY_CONCURRENCY=2
PASSWORD_VERIFY_QUEUE_TIMEOUT_SECONDS=5

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VITE_API_BASE_URL=http://localhost:8000

# External model gateway (Colab, ml/model-gateway). LLM_BASE_URL is the gateway ROOT
# (no trailing /v1); routes are /v1/chat/completions, /v1/embeddings, /check, /health.
# /ready reports model_inference=external_unchecked, never "available".
LLM_BASE_URL=
MODEL_GATEWAY_TOKEN=
# gateway (default): real inference only; unset gateway -> runs fail model_unavailable.
# fake: deterministic development double, labelled FAKE everywhere (refused in production).
MODEL_MODE=gateway

# M3 retrieval: dense (default, measured first) or hybrid (dense + sparse, RRF).
RETRIEVAL_MODE=dense
